/* The selector's bottom band, drawn over the stage like the menu (same fonts and hint line).
   Sized in vh: the context is the window's size, so the band reads the same on any display. */

* {
	box-sizing: border-box;
}

body {
	width: 100%;
	height: 100%;
	font-family: "Fira Sans";
	font-size: 1.6vh;
	color: #E0DBC8;
}

#band {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	padding: 1.3vh 3vh 1.1vh 3vh;
	background-color: rgba(0, 0, 0, 78%);
	text-align: center;
}

#stage-titles {
	display: block;
	font-family: "Fira Sans Condensed";
	font-weight: bold;
	font-size: 2.6vh;
}

.stage-title {
	display: inline-block;
	margin: 0 1.7vh;
	color: rgba(224, 219, 200, 38%);
}

.stage-title.on {
	color: #F4EFDC;
}

.hint {
	display: block;
	margin-top: 0.5vh;
	font-size: 1.6vh;
	color: rgba(224, 219, 200, 55%);
}

glyph {
	font-family: PromptFont;
	font-size: 1.3em;
	color: #E0DBC8;
}
