---
Checks: >-
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  readability-braces-around-statements
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(runtime|common|tests|tools)/'
ExcludeHeaderFilterRegex: '(^|/)vendor/'
SystemHeaders: false
CheckOptions:
  readability-braces-around-statements.ShortStatementLines: '0'
FormatStyle: file
...
