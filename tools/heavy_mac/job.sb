;; job.sb — the sandbox every heavy job from Fedora runs in on the Mac (heavy_mac_worker.py).
;;
;; The job is code from another machine, so it sees only its own work area (WORK: the mirrored trees, its HOME,
;; caches and temp), the PSX disc images (DISCS) and the worker's tool copies (TOOLS). The rest of the user's home,
;; other volumes, shared temp dirs, the keychain, the clipboard, local network services, other apps and other
;; processes are closed to it. Compilers and system frameworks outside /Users stay readable.
(version 1)
(allow default)

;; Reads: nothing under /Users, /Volumes or the shared temp dirs except the job's own areas.
(deny file-read* (subpath "/Users") (subpath "/Volumes") (subpath "/private/tmp") (subpath "/private/var/folders")
                 (subpath "/private/var/tmp"))
(allow file-read-metadata (literal "/Users") (literal (param "HOME_REAL")))
(allow file-read* (subpath (param "WORK")) (subpath (param "DISCS")) (subpath (param "TOOLS")))
(allow file-read-metadata (literal (param "ROOT")))

;; Writes: only the work area and the terminal devices.
(deny file-write*)
(allow file-write* (subpath (param "WORK")) (literal "/dev/null") (literal "/dev/zero") (regex #"^/dev/tty")
                   (regex #"^/dev/fd/") (regex #"^/dev/ptmx$") (regex #"^/dev/ttys"))

;; No keychain, clipboard, opening apps or scripting them.
(deny mach-lookup (global-name "com.apple.SecurityServer") (global-name "com.apple.securityd")
                  (global-name "com.apple.secd")
                  (global-name-regex #"^com\.apple\.pasteboard"))
(deny appleevent-send)
(deny lsopen)

;; Network: web downloads only (ports 80 and 443, for dependencies) and name lookups. Nothing on this machine,
;; no ssh or file sharing to the LAN, no unix sockets (ssh-agent and other local services).
(deny network-outbound)
(allow network-outbound (remote ip "*:443") (remote ip "*:80"))
(deny network-outbound (remote ip "localhost:*"))
(allow network-outbound (remote unix-socket (path-literal "/private/var/run/mDNSResponder")))  ; name lookups
(deny network-bind)

;; Other processes: no signalling or inspecting anything outside this sandbox.
(deny signal)
(allow signal (target same-sandbox))
(deny process-info*)
(allow process-info* (target self))
(allow process-info* (target same-sandbox))
