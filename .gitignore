# Build dirs
build/
build-*/
build2/

# Scratch / run artifacts (see CLAUDE.md — never /tmp; all tooling output goes here)
scratch/

# Auto-memory (Claude session-local; per-machine, never committed — see CLAUDE.md "Global working principles")
memory/
# stray manual frame-dump dir (PSXPORT_VK_SHOTSEQ qdir) — artifacts belong in scratch/
/x/

# Local config (ROM path etc.)
.env

# ROM / disc drop-ins (never commit copyrighted assets)
*.chd
*.bin
# the psxport fastboot OpenBIOS build is MIT and committed deliberately
!bios/openbios-fast.bin
*.cue
*.iso
*.img
*.exe
*.psexe
bios/scph5501.bin

# OpenBIOS source: reproducible build input (scripts/build_openbios.py clones it); not vendored
vendor/openbios-src/

__pycache__/
*.pyc

.claude/

# standalone offline XA extractor binary (built by tools/build_xa_wavdump.py)
tools/xa_wavdump
# FMV STR extract/decode binaries (built by tools/fmv_export/build.py)
tools/fmv_export/fmv_export
tools/fmv_export/test_fmv_decode
psxport_settings.ini
docs/reference/issues/shot_*.png
*.log

# out-of-tree build dirs for hermetic tests (build/ is already ignored)
build_*/
